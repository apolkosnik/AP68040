function automatic logic [8:0] sel_index(input logic [NENT-1:0] s);
	logic [8:0] x;
	x = '0;
	for (int i = 0; i < NENT; i++) if (s[i]) x = x | 9'(i);
	sel_index = x;
endfunction
function automatic pla_t dec_pla(input logic [15:0] op);
	logic [NENT-1:0] s;
	s = dec_sel(op);
	dec_pla = ent_attr(sel_index(s), |s);
endfunction
